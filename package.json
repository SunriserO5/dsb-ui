    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.5.12",
    "lucide-react": "^0.468.0",
    "ws": "^8.18.0"
  }
}
